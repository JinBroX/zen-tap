{
  "id": "Q50",
  "hexName": "火风鼎",
  "judgment": {
    "situation": "鼎是礼器也是炊具——既有威严，也管民生。",
    "movement": "火在木上烧，鼎在火上立，热力从下往上稳定输出。",
    "timing": "根基已经到位，可以正式开张。",
    "risk": "鼎足易折，一旦倾斜满盘皆输。",
    "outcome": "权威确立后，天下归心。"
  },
  "lines": [
    {
      "line": 1,
      "text": "鼎足颠倒，根基倾覆。"
    },
    {
      "line": 2,
      "text": "鼎中盈实，吃食在即。"
    },
    {
      "line": 3,
      "text": "鼎耳脱落，无可把持。"
    },
    {
      "line": 4,
      "text": "鼎足折断，倾覆难止。"
    },
    {
      "line": 5,
      "text": "金耳黄铉，坚实贵重。"
    },
    {
      "line": 6,
      "text": "玉铉华美，高贵吉祥。"
    }
  ]
}