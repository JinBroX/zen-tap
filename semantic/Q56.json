{
  "id": "Q56",
  "hexName": "火山旅",
  "judgment": {
    "situation": "火在山上烧，转瞬即逝——人在异乡，没有根。",
    "movement": "不断移动，无法在一个地方长留。",
    "timing": "短期策略，不是长久之计。",
    "risk": "过度漂泊，失去归属和身份。",
    "outcome": "找到落脚点之前，只能继续赶路。"
  },
  "lines": [
    {
      "line": 1,
      "text": "旅途琐碎，为人轻贱。"
    },
    {
      "line": 2,
      "text": "寻得住处，暂且容身。"
    },
    {
      "line": 3,
      "text": "住所起火，无处安身。"
    },
    {
      "line": 4,
      "text": "旅居他乡，身心不安。"
    },
    {
      "line": 5,
      "text": "射雉得获，终有所得。"
    },
    {
      "line": 6,
      "text": "鸟巢烧毁，先笑后哭。"
    }
  ]
}