{
  "id": "Q46",
  "hexName": "地风升",
  "judgment": {
    "situation": "木生于地，缓慢而不可逆地向上生长。",
    "movement": "每一步都踩在实处，没有虚浮。",
    "timing": "正在上升通道中，不可打断。",
    "risk": "升得太快，根基跟不上。",
    "outcome": "持续积累，终达高处。"
  },
  "lines": [
    {
      "line": 1,
      "text": "被允许往上升，路上没人拦。"
    },
    {
      "line": 2,
      "text": "有了信任，才能继续向上。"
    },
    {
      "line": 3,
      "text": "升到高处，脚下是空的。"
    },
    {
      "line": 4,
      "text": "大人物要用你，没得躲。"
    },
    {
      "line": 5,
      "text": "稳住就吉，乱动反而坏事。"
    },
    {
      "line": 6,
      "text": "升到看不清的地方，回头已经晚了。"
    }
  ]
}