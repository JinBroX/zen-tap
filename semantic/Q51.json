{
  "id": "Q51",
  "hexName": "震为雷",
  "judgment": {
    "situation": "平地一声雷，所有人都被震住。",
    "movement": "惊雷连环，无处可躲——只能正面应对。",
    "timing": "事发突然，来不及准备。",
    "risk": "慌不择路，做出错误反应。",
    "outcome": "惊雷过后，反而让人清醒。"
  },
  "lines": [
    {
      "line": 1,
      "text": "惊雷滚来，人人失色。"
    },
    {
      "line": 2,
      "text": "雷霆再至，惊险万分。"
    },
    {
      "line": 3,
      "text": "雷声过后，万物苏醒。"
    },
    {
      "line": 4,
      "text": "震雷陷足，动弹不得。"
    },
    {
      "line": 5,
      "text": "雷往风息，损失无多。"
    },
    {
      "line": 6,
      "text": "雷声收尽，天地归静。"
    }
  ]
}