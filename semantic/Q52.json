{
  "id": "Q52",
  "hexName": "艮为山",
  "judgment": {
    "situation": "山在前面，走不通了。",
    "movement": "动极当静，强行推进只会翻车。",
    "timing": "现在不是行动的时候，停比冲好。",
    "risk": "把停歇当成撤退，丧失机会。",
    "outcome": "止得恰当，后面反而顺。"
  },
  "lines": [
    {
      "line": 1,
      "text": "脚趾止步，不踏前路。"
    },
    {
      "line": 2,
      "text": "小腿被阻，欲行不能。"
    },
    {
      "line": 3,
      "text": "腰身困住，无法转动。"
    },
    {
      "line": 4,
      "text": "全身静止，安守其位。"
    },
    {
      "line": 5,
      "text": "口舌收敛，言语不多。"
    },
    {
      "line": 6,
      "text": "厚实如山，自然知止。"
    }
  ]
}